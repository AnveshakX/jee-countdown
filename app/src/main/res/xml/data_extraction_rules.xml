<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing personal goes to cloud backup; a direct phone-to-phone transfer still carries everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="p.xml" />
        <exclude domain="sharedpref" path="cfg.xml" />
        <exclude domain="file" path="bg.jpg" />
        <exclude domain="file" path="bg.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
